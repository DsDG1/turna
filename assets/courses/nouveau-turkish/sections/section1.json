{
  "id": "nt-s1",
  "name": "起步 · Merhaba",
  "description": "A1 起步：问候、点单、道谢，以及和土耳其语的第一次见面。",
  "units": [
    {
      "id": "nt-u1",
      "name": "第 1 单元 · 咖啡馆的第一步",
      "description": "场景：一家土耳其咖啡馆。学会打招呼、点一杯饮品、道谢。",
      "lessons": [
        {
          "id": "nt-u1-l1",
          "name": "Merhaba!",
          "description": "第 1 课：欢迎来到土耳其语的世界——你早就认识一些土耳其语，再见见它的三个怪脾气，最后收下第一句见面礼。",
          "type": "normal",
          "template": "intro",
          "prerequisiteLessonIds": [],
          "content": {
            "subLessons": [
              {
                "id": "nt-u1-l1-sl1",
                "name": "欢迎来到土耳其语的世界",
                "stages": [
                  {
                    "id": "st-icebreaker",
                    "name": "你早就认识土耳其语",
                    "items": [
                      {
                        "runtimeType": "showWord",
                        "id": "sw-turkce",
                        "wordId": "nt-w-turkce",
                        "context": "欢迎来到土耳其语的世界。Türkçe 就是「土耳其语」——大约 8000 多万人的母语。"
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-turkce",
                        "prompt": "Türkçe 是什么意思？",
                        "options": ["土耳其语", "英语", "法语"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-doner",
                        "prompt": "烤肉店里的 döner kebab，döner 的本义是？",
                        "options": ["转", "肉", "火"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-yogurt",
                        "prompt": "「酸奶」这个词原本来自哪种语言？",
                        "options": ["土耳其语", "法语", "日语"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "multiSelect",
                        "id": "ms-cognates",
                        "prompt": "下面哪些土耳其语词，你看着眼熟？（提示：有一个和中文的「茶」是亲戚，有一个听起来像「咖啡」）",
                        "options": ["çay", "kahve", "döner", "su"],
                        "correctIndices": [0, 1]
                      }
                    ]
                  },
                  {
                    "id": "st-first-look",
                    "name": "土耳其语的三个怪脾气",
                    "items": [
                      {
                        "runtimeType": "reorderSentence",
                        "id": "rs-word-order",
                        "prompt": "「我要一杯咖啡」（istiyorum=我要，bir=一，kahve=咖啡）",
                        "scrambled": ["kahve", "istiyorum", "bir"],
                        "correct": ["bir", "kahve", "istiyorum"]
                      },
                      {
                        "runtimeType": "showWord",
                        "id": "sw-ev",
                        "wordId": "nt-w-ev",
                        "context": "土耳其语的词像小火车：ev（房子）→ evim（我的房子）→ evimde（在我的房子里），车厢一节一节挂上去。"
                      },
                      {
                        "runtimeType": "fillBlank",
                        "id": "fb-ev-derivative",
                        "sentence": "ev（房子）→ evim（我的房子）→ _____（在我的房子里）",
                        "answer": "evimde",
                        "choices": ["evimde", "evim", "ev"]
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-letter-s",
                        "prompt": "土耳其语字母 ş 念什么？",
                        "options": [
                          "sh（像英语 show 的开头）",
                          "s（像英语 see 的开头）",
                          "ch（像英语 child 的开头）"
                        ],
                        "correctIndex": 0
                      }
                    ]
                  },
                  {
                    "id": "st-gift",
                    "name": "第一句见面礼",
                    "items": [
                      {
                        "runtimeType": "showWord",
                        "id": "sw-merhaba",
                        "wordId": "nt-w-merhaba",
                        "context": "见面礼：走进土耳其的任何一家店，先说这一句。"
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-merhaba",
                        "prompt": "merhaba 是什么意思？",
                        "options": ["你好", "再见", "谢谢"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "fillBlank",
                        "id": "fb-merhaba-first",
                        "sentence": "店员：Merhaba!\n你：_____",
                        "answer": "Merhaba!",
                        "choices": ["Merhaba!", "Teşekkürler!", "Türkçe!"]
                      },
                      {
                        "runtimeType": "translateSentence",
                        "id": "tr-merhaba",
                        "source": "你好",
                        "expected": "merhaba",
                        "hints": ["全小写", "7 个字母"]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "nt-u1-l1-sl2",
                "name": "Merhaba & Teşekkürler",
                "stages": [
                  {
                    "id": "st-review-merhaba",
                    "name": "Merhaba，练熟它",
                    "items": [
                      {
                        "runtimeType": "showWord",
                        "id": "sw-sl2-merhaba",
                        "wordId": "nt-w-merhaba",
                        "context": "还记得上一小节的那句见面礼吗？再听一遍——走进咖啡馆的第一句话。"
                      },
                      {
                        "runtimeType": "fillBlank",
                        "id": "fb-sl2-reply",
                        "sentence": "— Merhaba!\n— _____",
                        "answer": "Merhaba!",
                        "choices": ["Teşekkürler!", "Merhaba!", "Türkçe!"]
                      },
                      {
                        "runtimeType": "translateSentence",
                        "id": "tr-sl2-mer",
                        "source": "你好",
                        "expected": "merhaba",
                        "hints": ["全小写", "7 个字母"]
                      },
                      {
                        "runtimeType": "readAloud",
                        "id": "ra-sl2-merhaba",
                        "targetText": "Merhaba!",
                        "prompt": "进店的第一句，这次读出声来——应用会听你读得怎么样"
                      }
                    ]
                  },
                  {
                    "id": "st-tesekkurler",
                    "name": "Teşekkürler 上场",
                    "items": [
                      {
                        "runtimeType": "showWord",
                        "id": "sw-sl2-tesekkurler",
                        "wordId": "nt-w-tesekkurler",
                        "context": "咖啡端上来了——这时候说：Teşekkürler（谢谢）。"
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-sl2-meaning",
                        "prompt": "teşekkürler 是什么意思？",
                        "options": ["谢谢", "你好", "再见"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "fillBlank",
                        "id": "fb-sl2-produce",
                        "sentence": "「谢谢」= _____",
                        "answer": "Teşekkürler",
                        "choices": ["Teşekkürler", "Merhaba", "Türkçe"]
                      },
                      {
                        "runtimeType": "reorderSentence",
                        "id": "rs-sl2-formal",
                        "prompt": "更客气的一版：「谢谢您」",
                        "scrambled": ["ederim", "Teşekkür"],
                        "correct": ["Teşekkür", "ederim"]
                      },
                      {
                        "runtimeType": "translateSentence",
                        "id": "tr-sl2-tes",
                        "source": "谢谢",
                        "expected": "teşekkürler",
                        "hints": ["全小写", "11 个字母", "有两个字母带点：ş 和 ü"]
                      }
                    ]
                  },
                  {
                    "id": "st-two-lines",
                    "name": "两句话合起来",
                    "items": [
                      {
                        "runtimeType": "reorderSentence",
                        "id": "rs-sl2-combo",
                        "prompt": "走进咖啡馆时说的一句 → 接过咖啡时说的一句",
                        "scrambled": ["Teşekkürler!", "Merhaba!"],
                        "correct": ["Merhaba!", "Teşekkürler!"]
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-sl2-spell-mer",
                        "prompt": "「你好」的正确拼写是？",
                        "options": ["merhaba", "merhabba", "merheba"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "multipleChoice",
                        "id": "mc-sl2-spell-tes",
                        "prompt": "「谢谢」的正确拼写是？（注意 ş 和 ü 头上的点，还有双 k）",
                        "options": ["teşekkürler", "teşekürler", "teşekkuler"],
                        "correctIndex": 0
                      },
                      {
                        "runtimeType": "readAloud",
                        "id": "ra-sl2-tesekkurler",
                        "targetText": "Teşekkürler!",
                        "prompt": "接过咖啡的这句也读一遍。跟读需要麦克风权限，识别由系统语音服务完成"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "nt-u1-l2-dialogue",
          "name": "咖啡馆的第一句",
          "description": "走进 Ayşe 的咖啡馆，亲自回应问候，并在接过饮品时道谢。Buyurun 只需听懂，不要求产出。",
          "type": "dialogue",
          "template": "dialogue",
          "prerequisiteLessonIds": ["nt-u1-l1"],
          "content": {
            "dialogueScene": {
              "id": "nt-scene-cafe-welcome",
              "title": "Ayşe 的咖啡馆",
              "characters": [
                {
                  "id": "ayse",
                  "name": "Ayşe",
                  "imageAsset": "assets/images/ayse.png"
                },
                {
                  "id": "learner",
                  "name": "你"
                }
              ],
              "turns": [
                {
                  "id": "nt-dialogue-turn-1",
                  "speakerId": "ayse",
                  "text": "Merhaba!"
                },
                {
                  "id": "nt-dialogue-turn-2",
                  "speakerId": "learner",
                  "interactionId": "nt-dialogue-reply-merhaba"
                },
                {
                  "id": "nt-dialogue-turn-3",
                  "speakerId": "ayse",
                  "text": "Buyurun!"
                },
                {
                  "id": "nt-dialogue-turn-4",
                  "speakerId": "learner",
                  "interactionId": "nt-dialogue-formal-thanks"
                },
                {
                  "id": "nt-dialogue-turn-5",
                  "speakerId": "ayse",
                  "text": "Teşekkürler!"
                },
                {
                  "id": "nt-dialogue-turn-6",
                  "speakerId": "learner",
                  "interactionId": "nt-dialogue-type-thanks"
                },
                {
                  "id": "nt-dialogue-turn-7",
                  "speakerId": "learner",
                  "interactionId": "nt-dialogue-read-thanks"
                }
              ]
            },
            "stages": [
              {
                "id": "nt-dialogue-stage-responses",
                "name": "回应 Ayşe",
                "items": [
                  {
                    "runtimeType": "fillBlank",
                    "id": "nt-dialogue-reply-merhaba",
                    "sentence": "— Merhaba!\n— _____",
                    "answer": "Merhaba!",
                    "choices": ["Merhaba!", "Teşekkürler!", "Türkçe!"]
                  },
                  {
                    "runtimeType": "reorderSentence",
                    "id": "nt-dialogue-formal-thanks",
                    "prompt": "接过饮品，用更客气的一版说「谢谢您」",
                    "scrambled": ["ederim", "Teşekkür"],
                    "correct": ["Teşekkür", "ederim"]
                  },
                  {
                    "runtimeType": "translateSentence",
                    "id": "nt-dialogue-type-thanks",
                    "source": "谢谢",
                    "expected": "teşekkürler",
                    "hints": ["全小写", "注意 ş、ü 和双 k"]
                  },
                  {
                    "runtimeType": "readAloud",
                    "id": "nt-dialogue-read-thanks",
                    "targetText": "Teşekkürler!",
                    "prompt": "把最后这句道谢说出口"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
