<?xml version="1.0" encoding="utf-8"?>
<!-- API 27+: light navigation bar icons on light chrome. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/turna_appbar_light</item>
        <item name="android:navigationBarColor">@color/turna_appbar_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/turna_scaffold_light</item>
        <item name="android:statusBarColor">@color/turna_appbar_light</item>
        <item name="android:navigationBarColor">@color/turna_appbar_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
