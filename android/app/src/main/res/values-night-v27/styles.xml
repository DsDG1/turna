<?xml version="1.0" encoding="utf-8"?>
<!-- API 27+ night: dark chrome; light nav icons off. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/turna_appbar_dark</item>
        <item name="android:navigationBarColor">@color/turna_appbar_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/turna_scaffold_dark</item>
        <item name="android:statusBarColor">@color/turna_appbar_dark</item>
        <item name="android:navigationBarColor">@color/turna_appbar_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
