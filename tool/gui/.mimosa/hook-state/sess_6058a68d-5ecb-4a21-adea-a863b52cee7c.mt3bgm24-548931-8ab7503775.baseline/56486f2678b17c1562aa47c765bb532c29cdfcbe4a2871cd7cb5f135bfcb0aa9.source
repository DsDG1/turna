"""Unit tests for the JsonEditor widget (needs QApplication offscreen)."""
from __future__ import annotations

import json
import sys
import unittest
from pathlib import Path

_GUI = Path(__file__).resolve().parents[1]
if str(_GUI) not in sys.path:
    sys.path.insert(0, str(_GUI))
from tests._qtapp import qt_app  # noqa: E402

from src.widgets.json_editor import JsonEditor


class TestJsonEditor(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.app = qt_app()

    def _editor(self) -> JsonEditor:
        return JsonEditor()

    def test_format_pretty_prints(self) -> None:
        e = self._editor()
        e.setPlainText('{"id":"s1","units":[]}')
        self.assertTrue(e.format())
        self.assertIn('  "id"', e.toPlainText())  # indented

    def test_format_invalid_returns_false_and_marks(self) -> None:
        e = self._editor()
        marked: list[tuple[int, str]] = []
        e.error_marked.connect(lambda line, msg: marked.append((line, msg)))
        e.setPlainText('{"a":1 "b":2}')  # missing comma
        self.assertFalse(e.format())
        self.assertTrue(len(marked) >= 1)
        self.assertGreaterEqual(marked[0][0], 1)

    def test_to_json_roundtrip(self) -> None:
        e = self._editor()
        e.set_json({"id": "s1", "units": [{"id": "u1"}]})
        self.assertEqual(e.to_json(), {"id": "s1", "units": [{"id": "u1"}]})

    def test_to_json_invalid_raises(self) -> None:
        e = self._editor()
        e.setPlainText("{not json}")
        with self.assertRaises(ValueError):
            e.to_json()

    def test_ctrl_shift_f_formats(self) -> None:
        from PySide6.QtCore import QEvent, Qt
        from PySide6.QtGui import QKeyEvent

        e = self._editor()
        e.setPlainText('{"a":1}')
        ev = QKeyEvent(QEvent.Type.KeyPress, Qt.Key.Key_F,
                       Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.ShiftModifier)
        e.keyPressEvent(ev)
        self.assertIn('  "a"', e.toPlainText())


if __name__ == "__main__":
    unittest.main()