    "structure and reuse existing ids where possible."
)


@dataclass
class AiCourseSpec:
    language: str = "Turkish"          # Target language being taught
    source_language: str = "Chinese"   # Language used for prompts/hints
    topic: str = ""
    level: str = "A1"
    unit_count: int = 1
