{
  "comment": "Shared allow/deny vectors. encodedName is the single /media/ path segment after the prefix, still percent-encoded. Dart and Kotlin must decode it once.",
  "originHost": "anki.local",
  "mediaPrefix": "/media/",
  "vectors": [
    {"id": "space", "encodedName": "hello%20world.png", "expectedName": "hello world.png", "allowed": true, "createFile": true},
    {"id": "paren", "encodedName": "paren%20(1).mp3", "expectedName": "paren (1).mp3", "allowed": true, "createFile": true},
    {"id": "unicode", "encodedName": "%E4%B8%AD%E6%96%87%E5%9B%BE%E7%89%87.jpg", "expectedName": "中文图片.jpg", "allowed": true, "createFile": true},
    {"id": "hash", "encodedName": "hash%23tag.bin", "expectedName": "hash#tag.bin", "allowed": true, "createFile": true},
    {"id": "question", "encodedName": "question%3F.png", "expectedName": "question?.png", "allowed": true, "createFile": true},
    {"id": "percent", "encodedName": "percent%2520.txt", "expectedName": "percent%20.txt", "allowed": true, "createFile": true},
    {"id": "foo_dotdot", "encodedName": "foo..bar.png", "expectedName": "foo..bar.png", "allowed": true, "createFile": true},
    {"id": "plus_literal", "encodedName": "a+b.png", "expectedName": "a+b.png", "allowed": true, "createFile": true},
    {"id": "amp", "encodedName": "a%26b.png", "expectedName": "a&b.png", "allowed": true, "createFile": true},
    {"id": "eq", "encodedName": "a=b.png", "expectedName": "a=b.png", "allowed": true, "createFile": true},
    {"id": "comma", "encodedName": "a%2Cb.png", "expectedName": "a,b.png", "allowed": true, "createFile": true},
    {"id": "at", "encodedName": "user%40host.png", "expectedName": "user@host.png", "allowed": true, "createFile": true},
    {"id": "semi", "encodedName": "a%3Bb.png", "expectedName": "a;b.png", "allowed": true, "createFile": true},
    {"id": "brackets", "encodedName": "a%5B1%5D.png", "expectedName": "a[1].png", "allowed": true, "createFile": true},
    {"id": "single_quote", "encodedName": "o%27brian.png", "expectedName": "o'brian.png", "allowed": true, "createFile": true},
    {"id": "emoji", "encodedName": "%F0%9F%8E%B5.mp3", "expectedName": "🎵.mp3", "allowed": true, "createFile": true},
    {"id": "combining", "encodedName": "cafe%CC%81.png", "expectedName": "café.png", "allowed": true, "createFile": true},
    {"id": "long_name", "encodedName": "very-long-media-file-name-that-is-still-a-single-segment.webp", "expectedName": "very-long-media-file-name-that-is-still-a-single-segment.webp", "allowed": true, "createFile": true},
    {"id": "woff2", "encodedName": "_font.woff2", "expectedName": "_font.woff2", "allowed": true, "createFile": true},
    {"id": "css_underscore", "encodedName": "_card.css", "expectedName": "_card.css", "allowed": true, "createFile": true},
    {"id": "tilde", "encodedName": "backup~.png", "expectedName": "backup~.png", "allowed": true, "createFile": true},
    {"id": "dotfile", "encodedName": ".hidden.png", "expectedName": ".hidden.png", "allowed": true, "createFile": true},
    {"id": "multi_dot", "encodedName": "archive.tar.bz2", "expectedName": "archive.tar.bz2", "allowed": true, "createFile": true},
    {"id": "cjk_space", "encodedName": "%E8%AF%BE%E7%A8%8B%20file.jpg", "expectedName": "课程 file.jpg", "allowed": true, "createFile": true},
    {"id": "hebrew", "encodedName": "%D7%A9%D7%9C%D7%95%D7%9D.png", "expectedName": "שלום.png", "allowed": true, "createFile": true},
    {"id": "traversal_dotdot", "encodedName": "..%2Fsecret", "expectedName": "../secret", "allowed": false},
    {"id": "traversal_plain", "encodedName": "%2e%2e%2fsecret", "expectedName": "../secret", "allowed": false},
    {"id": "double_encoded_traversal", "encodedName": "%252e%252e%252fsecret", "expectedName": "%2e%2e%2fsecret", "allowed": false},
    {"id": "absolute_unix", "encodedName": "%2Fetc%2Fpasswd", "expectedName": "/etc/passwd", "allowed": false},
    {"id": "absolute_drive", "encodedName": "C%3A%2Fsecret", "expectedName": "C:/secret", "allowed": false},
    {"id": "nested_slash", "encodedName": "a%2Fb.png", "expectedName": "a/b.png", "allowed": false},
    {"id": "backslash", "encodedName": "a%5Cb.png", "expectedName": "a\\b.png", "allowed": false},
    {"id": "nul", "encodedName": "nul%00x", "expectedName": "nul\u0000x", "allowed": false},
    {"id": "empty", "encodedName": "", "expectedName": "", "allowed": false},
    {"id": "dot_segment", "encodedName": ".", "expectedName": ".", "allowed": false},
    {"id": "dotdot_segment", "encodedName": "..", "expectedName": "..", "allowed": false},
    {"id": "malformed_percent", "encodedName": "bad%zz.png", "expectedName": null, "allowed": false},
    {"id": "truncated_percent", "encodedName": "bad%2", "expectedName": null, "allowed": false},
    {"id": "lone_percent", "encodedName": "%", "expectedName": null, "allowed": false},
    {"id": "encoded_backslash", "encodedName": "a%5c%2e%2e%5csecret", "expectedName": "a\\..\\secret", "allowed": false},
    {"id": "unc", "encodedName": "%5C%5Cserver%5Cshare", "expectedName": "\\\\server\\share", "allowed": false},
    {"id": "nested_dotdot_name", "encodedName": "ok%2F..%2Fsecret", "expectedName": "ok/../secret", "allowed": false},
    {"id": "space_encoded_slash", "encodedName": "hello%20%2Fetc%2Fpasswd", "expectedName": "hello /etc/passwd", "allowed": false},
    {"id": "colon_drive_lower", "encodedName": "c%3Asecret", "expectedName": "c:secret", "allowed": false}
  ]
}
