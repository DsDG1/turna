# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock is committed for reproducible builds across clones and CI.
# pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

#test/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

lib/configs/build_config.dart
.idea/
.flutter-plugins
.flutter-plugins-dependencies
.env
*.apk
.fvm

# AutoRoute / Freezed / json_serializable / injectable generated files.
# These are committed so a fresh clone can build without build_runner.
# Re-run `flutter pub run build_runner build` after changing annotations.
# **/*.gr.dart
# **/*.freezed.dart
# **/*.g.dart
# **/*.gen.dart
# injection.config.dart
.firebase/*

# mason
.mason/
mason-lock.json
upload-keystore.jks
.venv/
venv/

# iOS
private_keys/

# FVM Version Cache
.fvm/

# Firebase configuration files
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
node_modules/
serviceAccountKey.json

# Python
__pycache__/
*.py[cod]
*.pyo

# Flutter run logs
flutter_run.log
flutter_run.err.log
flutter_0*.log
flutter_*.log

# JVM / Gradle crash dumps accidentally left in android/
android/hs_err_pid*.log
android/replay_pid*.log

# Local scratch, editor, and Dart analysis caches
.tmp/
.tmp_appdata/
.tmp_localappdata/
**/.dart-appdata/
.commandcode/
readmetest.md
pubspec_overrides.yaml.disabled

# AI-assistant / IDE session state (plans, memory dumps, tool caches)
**/.zcode/plans/
**/.deveco/
**/.workbuddy/*.txt

# Teacher-tool local textbook workspaces
tool/var/

# Golden pixel failure dumps (regenerate locally; do not commit)
test/golden/failures/

# Build artifacts / release output
dist/

# IDE / editor metadata
.trae/
android/.kotlin/errors/
*.iml

# Textbook project migration backups (project.v1.json.bak etc.)
*.bak

# Official Anki native spike outputs. The .so is produced by
# native/turna_anki_core/build-android/build.sh and must not be
# hand-copied into git as a substitute for a reproducible build.
native/turna_anki_core/target/
android/app/src/main/jniLibs/**/libturna_anki.so

# Official Anki spike large packages are generated on demand.
test/fixtures/anki_official/generated/

# Temporarily vendored external reference repo (not part of this project)
anki-decryptBack/
# Mimosa security-scanner session state. Leading "**/" so nested copies
# (tool/gui/.mimosa, native/turna_anki_core/.mimosa) are also matched —
# plain ".mimosa/x/" patterns are anchored to the repo root and miss them.
# The root security-policy.json is project config and stays tracked.
**/.mimosa/**
!**/.mimosa/security-policy.json
