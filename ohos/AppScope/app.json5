{
  "app": {
    "bundleName": "me.dsdogs.turna.hmos",
    "vendor": "Turna",
    // `versionCode` / `versionName` are read by the fork's `AppInfo.getAppInfo`
    // but never consumed — hvigor overwrites both from `pubspec.yaml`'s
    // `buildName` / `buildNumber` via `ohos/local.properties`
    // (`updateLocalProperties`). So these two values are inert: the packaged
    // hap always reports pubspec's. They exist because the fork hard-casts
    // them (`app['app']['versionCode'] as int`) and a missing key is a
    // TypeError the surrounding `on Exception` does not catch.
    //
    // Kept in sync with pubspec anyway so nobody reads a number that lies.
    // Bump pubspec's `+N` and these together.
    //
    // No test asserts this sync today: `ohos_eol_architecture_guard_test.dart`
    // only checks that this file *exists*, not what it says. The comment that
    // used to claim otherwise was wrong — corrected 2026-10-20 rather than
    // left to imply a guard that does not exist.
    "versionCode": 6,
    "versionName": "0.9.1",
    // 分层图标（前景 + 背景各 1024x1024，见 media/layered_image.json）。
    // 云测试 50111 项要求图标必须分层且不得自带圆角/内边距，单层
    // app_icon.png（216x216）会在该项判不通过。原图保留作回退。
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
