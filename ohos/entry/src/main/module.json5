
{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      },
      // `AnkiReviewerProbeAbility` stays in `ets/probe/` but is deliberately
      // NOT registered here as of 2026-10-20. It is an `exported: true`
      // diagnostic ability whose only purpose was ADR 0050's on-device
      // evidence gathering; a release package carrying a launchable probe is
      // a finding waiting to happen in the cloud test security pass. Nothing
      // in `lib/` calls the two probe methods (the startup probe was removed
      // 2026-10-19), so unregistering costs no product behaviour — the plugin
      // side keeps `PROBE_ABILITY` and its handler, and they will simply
      // answer "ability does not exist" if anyone invokes them by hand.
      //
      // To take device evidence again, paste the block back:
      //
      //   {
      //     "name": "AnkiReviewerProbeAbility",
      //     "srcEntry": "./ets/probe/AnkiReviewerProbeAbility.ets",
      //     "description": "$string:EntryAbility_desc",
      //     "icon": "$media:icon",
      //     "label": "$string:EntryAbility_label",
      //     "startWindowIcon": "$media:icon",
      //     "startWindowBackground": "$color:start_window_background",
      //     "exported": true
      //   },
      // The reviewer itself — ADR 0050 §6 step 5b, route E. Carries no launcher
      // `skills` either: Dart reaches it through the plugin's
      // `startAbilityForResult`, exactly as the probe ability is reached.
      // `mediaRoot` arrives on the Want because only Dart knows where the
      // collection put its media folder.
      //
      // `launchType: singleton` is the platform default, stated explicitly
      // because its relaunch path needs the ability's `onNewWant`: a relaunch
      // onto the living instance delivers the new Want (and its mediaRoot)
      // there instead of `onCreate`, and without the handler the Want was
      // dropped entirely (B6).
      {
        "name": "AnkiReviewerAbility",
        "srcEntry": "./ets/entryability/AnkiReviewerAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton"
      }
    ],
    "requestPermissions": [
      {"name" :  "ohos.permission.INTERNET"},
      // Without this, `HapticFeedback.vibrate` answers `201 - Permission
      // denied` on every call, so the wrong-answer and level-up taps have no
      // haptic half. A device run showed it on each `HapticFeedbackType`
      // rather than at startup.
      {"name" :  "ohos.permission.VIBRATE"},
    ]
  }
}