
{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      },
      {
        // ADR 0050 §6 step 5b probe host. A separate UIAbility rather than a
        // second entry in `main_pages.json` because `@ohos.router` has been
        // deprecated since API 18 and this hap declares 5.1.0(18); the ability
        // boundary is the supported way to put a native page on screen from a
        // Flutter plugin, and `startAbilityForResult` brings the answer back
        // through the same call.
        //
        // `exported: true` is not an oversight and not a claim that another app
        // should launch this. A device run showed `startAbilityForResult`
        // answering `16000001 "The specified ability does not exist"` for an
        // ability `bm dump` listed as registered, and flipping only this flag
        // is the documented difference between "declared" and "launchable" on
        // that path. The ability carries no launcher `skills` and is not
        // reachable from the system UI; what it exposes is a Web page serving
        // one synthetic origin.
        "name": "AnkiReviewerProbeAbility",
        "srcEntry": "./ets/entryability/AnkiReviewerProbeAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      },
      // The reviewer itself — ADR 0050 §6 step 5b, route E. Carries no launcher
      // `skills` either: Dart reaches it through the plugin's
      // `startAbilityForResult`, exactly as the probe ability is reached.
      // `mediaRoot` arrives on the Want because only Dart knows where the
      // collection put its media folder.
      {
        "name": "AnkiReviewerAbility",
        "srcEntry": "./ets/entryability/AnkiReviewerAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ],
    "requestPermissions": [
      {"name" :  "ohos.permission.INTERNET"},
      // Without this, `HapticFeedback.vibrate` answers `201 - Permission
      // denied` on every call, so the wrong-answer and level-up taps have no
      // haptic half. A device run showed it on each `HapticFeedbackType`
      // rather than at startup.
      {"name" :  "ohos.permission.VIBRATE"},
    ]
  }
}