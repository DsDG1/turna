{
  app: {
    // Debug signing material — the trio that can be installed on a test device.
    // `type=release` profiles carry no `device-ids`, so a release-signed hap is
    // refused by the device profile check; only this one installs via hdc.
    //
    // The three files MUST come from the same generation: mixing a debug .p12
    // with a release .cer fails with `ERROR: 11111002 Certificates error`, and
    // the tool blames the keyAlias — a red herring, because `hap-sign-tool`
    // lower-cases the alias on both sides (`debugKey` does match `debugkey`).
    //
    // `storePassword` / `keyPassword` are DevEco **encrypted blobs**, never
    // plaintext: `DecipherUtil.decryptPwd` hex-decodes the field and
    // AES-128-GCM-decrypts it with the key material under
    // `~/.ohos/config/material`. Plaintext fails with 00303116 / 00303242.
    // Machine-local; the plaintext lives in the git-ignored `SIGNING.local.md`.
    //
    // For an AppGallery build, swap in `build-profile.json5.release` (the
    // parked release trio), build, then swap back.
    signingConfigs: [
      {
        name: 'default',
        type: 'HarmonyOS',
        material: {
          certpath: 'C:/Users/DsDogs/.ohos/config/default_ohos_MdDVtKO3JS8_9w1ljxwMRhHxfHKz0HggJMLRBtiUwJE=.cer',
          keyAlias: 'debugKey',
          keyPassword: '0000001B1A4761E45878DA6794260F11FABBF16AA47FA47EA115FA467B8AC8B0D6C97B362A4A9C330BB7C3',
          profile: 'C:/Users/DsDogs/.ohos/config/default_ohos_MdDVtKO3JS8_9w1ljxwMRhHxfHKz0HggJMLRBtiUwJE=.p7b',
          signAlg: 'SHA256withECDSA',
          storeFile: 'C:/Users/DsDogs/.ohos/config/default_ohos_MdDVtKO3JS8_9w1ljxwMRhHxfHKz0HggJMLRBtiUwJE=.p12',
          storePassword: '0000001BB30B139B42F9387C3C98FB6A721631721902EEDBA5609EA9F3FC631BF22346272B5EBDDE491D25',
        },
      },
    ],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        compatibleSdkVersion: '5.1.0(18)',
        runtimeOS: 'HarmonyOS',
        "targetSdkVersion": "26.0.0"
      },
    ],
    buildModeSet: [
      {
        name: 'debug'
      },
      {
        name: 'profile'
      },
      {
        name: 'release'
      }
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
